# Copy to .env and fill in. Never commit the real .env file.

NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# --- Database (MySQL 8) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=quantumtrade
DB_PASSWORD=change-me
DB_NAME=quantumtrade
DB_CONNECTION_LIMIT=10
# Set to false to run `npm run migrate` as a separate deploy step instead.
MIGRATE_ON_START=true

# --- Auth ---
# Required, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
SESSION_TTL_HOURS=168
# Defaults to true when NODE_ENV=production (cookies only sent over HTTPS).
# COOKIE_SECURE=true

# --- HTTP ---
# Only needed if the frontend is served from a different origin than the API.
CORS_ORIGINS=
# Number of reverse proxies (load balancer, nginx) in front of the API.
TRUST_PROXY=0
# Serve the built frontend from this directory (single-container deploys).
# STATIC_DIR=../frontend/dist

# --- Market data ---
# Stocks (Indian NSE/BSE and worldwide) - recommended, free key at https://twelvedata.com/register
# Use exchange suffixes for non-US stocks: TCS.NSE, RELIANCE.BSE, VOD.LON
TWELVE_DATA_API_KEY=
# Alternatives for stocks (used when no Twelve Data key is set):
#   Finnhub  - real-time US quotes: https://finnhub.io/register
#   Alpha Vantage - https://www.alphavantage.co/support/#api-key (free tier: 25 requests/day)
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
# Optional CoinGecko demo key for higher crypto rate limits.
COINGECKO_API_KEY=
MARKET_DATA_TIMEOUT_MS=8000
# Free stock plans allow only a few requests per minute: keep quotes cached for 120s or more.
STOCK_QUOTE_CACHE_SECONDS=120
# Dashboard indices strip, as comma-separated Label=SYMBOL pairs (ETFs track the indices on free plans).
# MARKET_INDICES=S&P 500 (SPY ETF)=SPY,Nasdaq 100 (QQQ ETF)=QQQ,Dow Jones (DIA ETF)=DIA,Nifty 50 (NIFTYBEES ETF)=NIFTYBEES.NSE

# --- Background jobs ---
# How often price alerts are evaluated. 0 disables the scheduler.
ALERT_CHECK_INTERVAL_SECONDS=300
