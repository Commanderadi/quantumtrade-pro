# Copy to .env and fill in. Never commit the real .env file.

NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# --- Database (MySQL 8) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=quantumtrade
DB_PASSWORD=change-me
DB_NAME=quantumtrade
DB_CONNECTION_LIMIT=10
# Set to false to run `npm run migrate` as a separate deploy step instead.
MIGRATE_ON_START=true

# --- Auth ---
# Required, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
SESSION_TTL_HOURS=168
# Defaults to true when NODE_ENV=production (cookies only sent over HTTPS).
# COOKIE_SECURE=true

# --- HTTP ---
# Only needed if the frontend is served from a different origin than the API.
CORS_ORIGINS=
# Number of reverse proxies (load balancer, nginx) in front of the API.
TRUST_PROXY=0
# Serve the built frontend from this directory (single-container deploys).
# STATIC_DIR=../frontend/dist

# --- Market data ---
# Stocks: https://www.alphavantage.co/support/#api-key (free tier: 25 requests/day)
ALPHA_VANTAGE_API_KEY=
# Optional, recommended: real-time stock quotes with a much higher free limit.
# https://finnhub.io/register
FINNHUB_API_KEY=
# Optional CoinGecko demo key for higher crypto rate limits.
COINGECKO_API_KEY=
MARKET_DATA_TIMEOUT_MS=8000

# --- Background jobs ---
# How often price alerts are evaluated. 0 disables the scheduler.
ALERT_CHECK_INTERVAL_SECONDS=300
